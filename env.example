# All optional — the dashboard works with none of these set.
# Where the browser fetches the manifest + quantized graphs (a Hugging Face MODEL repo, static
# bytes only — never a Space, never a server we run). Leave unset and the engine reports
# "unpublished" and the app runs on Tier-0 alone. Use /dev-model locally to exercise the full
# inference path against the bundled plumbing-test export.
NEXT_PUBLIC_LAYA_MODEL_BASE=https://huggingface.co/kasauti/laya-multilingual-onnx/resolve/main
# Tier-2 "Why?" explanations (text-only)
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b
# Shared verdict cache (otherwise per-instance memory)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# onnxruntime-web build location. Pinned for reproducibility; override if you self-host it.
# The INT8 graph runs on the WASM EP, the 4-bit graph on the WebGPU EP.
NEXT_PUBLIC_ORT_BASE=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.23.0/dist/

# Telephony/IVR adapter — the ONE documented audio exception. Off by default, so a normal deploy
# reports "audioRoutes: 0". Set to 1 only if you terminate a phone line whose provider transcribes
# the caller's speech; the transcript is used in-memory and never stored.
IVR_ENABLED=0
